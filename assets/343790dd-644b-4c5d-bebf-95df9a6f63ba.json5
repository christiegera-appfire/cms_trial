{
  "type": "rest",
  "uri": "https://xkcd.com/info.0.json",
  "children": [
    {
      "type": "view",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "alignItems": "center",
        "gap": 16
      },
      "children": [
        {
          "type": "text",
          "text": "{title}",
          "style": {
            "fontSize": 20,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        {
          "type": "image",
          "src": "{img}",
          "style": {
            "maxWidth": "100%",
            "borderRadius": 8,
            "boxShadow": "0 1px 4px rgba(0, 0, 0, 0.1)"
          }
        },
        {
          "type": "text",
          "text": "{alt}",
          "style": {
            "fontSize": 14,
            "fontStyle": "italic",
            "textAlign": "center",
            "maxWidth": "80%"
          }
        }
      ]
    }
  ]
}

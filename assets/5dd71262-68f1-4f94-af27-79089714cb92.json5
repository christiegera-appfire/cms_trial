{
  type: 'stylesheet',
  children: {
    type: 'view',
    style: {
      display: 'flex',
      flexDirection: 'column',
      padding: 20,
      backgroundColor: '#f9f9f9',
      fontFamily: 'Arial, sans-serif',
      color: 'black'
    },
    children: [
      {
        type: 'view',
        class: 'section__content',
        style: {
          flexDirection: 'row',
        },
        children: [
          {
            type: 'chart',
            options: {
              chart: {
                width: 400,
                height: 300,
              },
            },
            data: {
              categories: [
                'Jan',
                'Feb',
                'Mar',
                'Apr',
                'May',
              ],
              series: [
                {
                  chartType: 'bar',
                  name: 'Revenue',
                  fill: '#82ca9d',
                  data: [
                    10,
                    15,
                    20,
                    25,
                    30,
                  ],
                },
                {
                  chartType: 'line',
                  name: 'Expenses',
                  stroke: '#8884d8',
                  data: [
                    5,
                    10,
                    15,
                    20,
                    25
                  ],
                },
              ],
            },
          },
          {
            type: 'piechart',
            options: {
              chart: {
                width: 400,
                height: 300,
              },
            },
            data: {
              series: [
                {
                  name: 'Stock',
                  stroke: '#000',
                  fill: 'blue',
                  label: true,
                  cx: '50%',
                  cy: '50%',
                  innerRadius: 70,
                  outerRadius: 90,
                  data: [
                    {
                      name: 'A',
                      value: 88,
                      color: '#8777D9',
                    },
                    {
                      name: 'B',
                      value: 55,
                      color: '#2684FF',
                    },
                  ],
                },
                {
                  name: 'Amounts',
                  stroke: '#000',
                  cx: '50%',
                  cy: '50%',
                  outerRadius: 60,
                  label: true,
                  data: [
                    {
                      name: 'A',
                      value: 33,
                      color: '#57D9A3',
                    },
                    {
                      name: 'B',
                      value: 60,
                      color: '#00C7E6',
                    },
                  ],
                },
              ],
            },
          },
        ],
      },
    ],
  },
  styles: {
    section: {
      display: 'flex',
      flexDirection: 'column',
      padding: 20,
      backgroundColor: '#fff',
      fontFamily: 'Arial, sans-serif',
      border: '1px solid #ddd',
      borderRadius: 6,
    },
    section__title: {
      fontSize: 18,
      fontWeight: 'bold',
      marginBottom: 8,
    },
    section__description: {
      fontSize: 14,
      color: '#555',
      paddingLeft: 10,
    },
    section__content: {
      marginTop: 10,
      paddingLeft: 10,
      display: 'flex',
      flexDirection: 'column',
      flexWrap: 'wrap',
      gap: 10,
    },
    cardDeck: {
      display: 'flex',
      flexDirection: 'row',
      flexWrap: 'wrap',
      gap: 20,
      padding: 10,
    },
    card: {
      position: 'relative',
      display: 'flex',
      padding: 10,
      flexDirection: 'column',
      alignItems: 'center',
      justifyContent: 'center',
      width: '200px',
      height: '200px',
      borderRadius: 4,
      backgroundColor: 'white',
      boxSizing: 'border-box',
      boxShadow: '0 2px 10px 0 #aaa',
    },
    'card--small': {
      width: '150px',
      height: '50px',
    },
  }
}
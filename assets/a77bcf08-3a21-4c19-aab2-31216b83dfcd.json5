{
  type: 'stylesheet',
  children: {
      type: 'view',
      style: {
        display: 'flex',
        flexDirection: 'column',
      },
      children: [
        {
          type: 'text',
          text: 'Monday Status',
          class: 'title'
        },
        { 
          type: 'selector',
          id: 'ICONS',
          document: {
            name: 'text-label.svg',
            'multiple-person': 'multiple-person.png',
            people: 'multiple-person.png',
            status: 'status.png',
            color: 'status.png',
            timerange: 'timeline.png',
            timeline: 'timeline.png',
            numeric: 'number.png',
            numbers: 'number.png',
            text: 'text.svg',
            dropdown: 'dropdown.svg',
            formula: 'formula.png',
            file: 'files.svg',
            checkbox: 'checkbox.png',
            link: 'link.svg',
            mail: 'mail.svg',
            date: 'date.png',
            mirror: 'mirror.svg',
            lookup: 'mirror.svg',
            board_relation: 'connect-boards.svg',
            rating: 'rating.png',
            progress: 'text-label.svg',
            item_id: 'text-label.svg',
            country: 'text-label.svg',
            doc: 'files.svg',
            phone: 'text-label.svg',
          },
          children: {
            type: 'graphql',
            id: 'monday', 
            uri: 'datasource://monday',
            query: "query GetBoards {\
              boards (ids: \"{{$initial.boardId}}\") {\
                id name state type workspace { id name }\
                columns { id title type settings_str }\
                items_page { cursor items { id name group { id title } column_values { id text type value } } } \
              }\
            }",
            // - Extract columns and JSON.parse settings_str
            path: '{\
              "columns": $map($.data.boards.columns, function($v) { $merge([$v, { "settings": $eval($v.settings_str) }]) }),\
              "items": $.data.boards.items_page.items\
            }',
            children: [
              // { type: 'json', path: '$root' },
              { 
                type: 'list',
                path: '$root.monday.columns',
                class: 'cardContainer',
                item: {
                  type: 'view',
                  class: 'card',
                  children: [
                    {
                      type: 'view',
                      class: 'row',
                      children: [
                        { 
                          type: 'image',
                          src: "https://ronindashboards-ci.herokuapp.com/app/assets/images/modules/monday/{{$lookup($root.ICONS, $.type)}}",
                          style: { height: 24 },
                        },
                        "{{$.title}}"
                      ] 
                    },
                    {
                      type: 'view',
                      class: 'cardBody',
                      children: [                      
                        { 
                          type: 'conditional',
                          condition: '$.type = "people"',
                          children: { 
                            type: 'view',
                            children: [
                              { 
                                type: 'selector', 
                                path: "(\
                                  $findColumnValue := $map(?, function($item) {$single($item.column_values, function($v) { $v.id = $.id})});\
                                  $getValues := $map(?, function($v) { $v.text });\
                                  $root.monday.items ~> $findColumnValue ~> $getValues ~> $distinct\
                                )",
                                children: [
                                  // { type: 'json', },
                                  {
                                    type: 'list',
                                    path: '$',
                                    class: 'row',
                                    item: {
                                      type: 'text',
                                      text: '{{$}}',
                                    }
                                  }
                                ],
                              },
                            ]
                          }
                        },
                        { 
                          type: 'conditional',
                          condition: '$.type = "status"',
                          children: { 
                            type: 'view',
                            style: { width: '100%', fontSize: 12, fontWeight: 400 },
                            children: [
                              { 
                                type: 'selector', 
                                path: "(\
                                  $labelColorHash := $merge($each($.settings.labels, function($v, $k) {{ $v: $lookup($.settings.labels_colors, $k).color }}));\
                                  /* Cannot reduce from text containing nulls: replacing with empty strings and jsonparse 'value' string */\
                                  $fixValue := function($v) {$merge([$v, { \"text\": $v.text = null ? \"--\" : $v.text, \"parsedValue\": $v.value = null ? {} : $eval($v.value) }])};\
                                  $findColumnValue := function($item) {$single($item.column_values, function($v) { $v.id = $.id})};\
                                  $statusArray := $map($root.monday.items, function($v) { $v ~> $findColumnValue ~> $fixValue });\
                                  $values := $each($statusArray{text: $count($)}, function($v, $k) {\
                                    {\"key\": $k, \"value\": $v, \"color\": $lookup($labelColorHash, $k)}\
                                  });\
                                )",
                                children: [
                                  { 
                                    type: 'list',
                                    path: '$',
                                    style: { width: '100%' },
                                    item: {
                                      type: 'view',
                                      class: 'row',
                                      style: { marginBottom: 5 },
                                      children: [
                                        {
                                          type: 'text',
                                          style: {
                                            whiteSpace: 'nowrap',
                                            width: 90,
                                          },
                                          text: "{{$.key}}",
                                        },
                                        {
                                          type: 'progress',
                                          variant: 'linear',
                                          style: { width: '100%' },
                                          value: '$.value',
                                          bgColor: '$.color',
                                          maxValue: '$count($root.monday.items)',
                                        },
                                        {
                                          type: 'text',
                                          style: {
                                            whiteSpace: 'nowrap',
                                            width: 20,
                                          },
                                          text: "{{$.value}}",
                                        },
                                      ]
                                    } 
                                  },

                                ],
                              },
                            ]
                          }
                        },
                        { 
                          type: 'conditional',
                          condition: '$.type = "date"',
                          children: { 
                            type: 'view',
                            children: [
                              { 
                                type: 'selector', 
                                path: "(\
                                  $findColumnValue := $map(?, function($item) {$single($item.column_values, function($v) { $v.id = $.id})});\
                                  $getValues := $map(?, function($v) { $v.text });\
                                  $root.monday.items ~> $findColumnValue ~> $getValues ~> $distinct ~> $sort\
                                )",
                                children: [
                                  // { type: 'json', },
                                  { 
                                    type: 'text',
                                    text: '{{$[0]}} - {{$[-1]}}'
                                  }
                                ],
                              },
                            ]
                          }
                        },                                             
                        { 
                          type: 'conditional',
                          condition: '$.type = "numbers"',
                          children: { 
                            type: 'view',
                            children: [
                              { 
                                type: 'selector', 
                                path: "(\
                                  $findColumnValue := $map(?, function($item) {$single($item.column_values, function($v) { $v.id = $.id})});\
                                  $getValues := $map(?, function($v) { $parseNumber($v.text) });\
                                  $root.monday.items ~> $findColumnValue ~> $getValues ~> $sum\
                                )",
                                children: [
                                  { 
                                    type: 'text',
                                    text: 'Total: {{$}}'
                                  }
                                ],
                              },
                            ]
                          }
                        },   
                        { 
                          type: 'conditional',
                          condition: '$.type = "rating"',
                          children: { 
                            type: 'view',
                            children: [
                              { 
                                type: 'selector', 
                                path: "(\
                                  $findColumnValue := $map(?, function($item) {$single($item.column_values, function($v) { $v.id = $.id})});\
                                  $getValues := $map(?, function($v) { $parseNumber($v.text) });\
                                  $gtZero := $filter(?, function($v) { $v>0 });\
                                  $root.monday.items ~> $findColumnValue ~> $getValues ~> $gtZero ~> $average ~> $formatNumber(?, '#.00')\
                                )",
                                children: [
                                  // { type: 'json', },
                                  { 
                                    type: 'text',
                                    text: '{{$}} / 5'
                                  }
                                ],
                              },
                            ]
                          }
                        },                                                
                        { 
                          type: 'conditional',
                          unless: '$.type in ["people", "status", "date", "numbers", "rating"]',
                          children: { 
                            type: 'view',
                            children: [
                              "{{$count($root.monday.items)}}",
                            ]
                          }
                        },
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
  },
  styles: {
    title: {
      fontSize: 26,
      fontWeight: 'bold',
      marginBottom: 20,
      textAlign: 'center',
      color: '#333',
    },
    row: {
      display: 'flex',
      flexDirection: 'row',
      alignItems: 'center',
      gap: 4
    },
    cardContainer: {
      display: 'flex',
      flexDirection: 'row',
      flexWrap: 'wrap',
      gap: 16
    },
    card: {
      width: "250px",
      display: "flex",
      flexDirection: "column",
      gap: 12,
      padding: 16,
      border: "1px solid #e1e4e8",
      borderRadius: 8,
      backgroundColor: "#ffffff",
      boxShadow: "0 1px 4px rgba(0, 0, 0, 0.1)",
      transition: "box-shadow 0.2s ease, transform 0.2s ease",
      cursor: "pointer",
      textAlign: "left"
    },
    cardBody: {
      alignItems: 'center',
      justifyContent: 'center',
      fontSize: 32,
      fontWeight: 600,
    }
  }
}